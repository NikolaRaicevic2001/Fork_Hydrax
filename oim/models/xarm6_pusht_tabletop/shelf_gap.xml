<mujoco model="xarm6_pusht_shelf_gap">
  <!-- Push the T between two shelves -- open_table plus two large static
       blocks that leave a gap between them.

       IsaacGym conf/task/sim_task03.yaml.

       conf/actors/shelf_1.yaml / shelf_2.yaml: box, full size
       0.2 x 0.25 x 0.2 m, init_pos [1.1, 0.05, 0.24] and [0.7, 0.05, 0.24]
       -> half-extents (0.10, 0.125, 0.10) at (0.4, 0.5) and (0.0, 0.5)
       after the (-0.7, +0.45) shift, resting on the tabletop.

       Note how tight this is, because these are IsaacGym's own numbers and
       not a retuning: the gap between the two shelves runs x in [0.1, 0.3],
       exactly 0.2 m wide, and the T-block's crossbar is exactly 0.2 m long.
       Straight through is a zero-clearance squeeze; going around the
       outside (x < -0.1 or x > 0.5) is the other option. That is the task
       as the source repo defines it. -->
  <include file="common.xml"/>
  <include file="tee.xml"/>

  <worldbody>
    <geom class="tabletop_obstacle" name="shelf_1" type="box" size="0.10 0.125 0.10" pos="0.4 0.5 0.10"/>
    <geom class="tabletop_obstacle" name="shelf_2" type="box" size="0.10 0.125 0.10" pos="0.0 0.5 0.10"/>
  </worldbody>
</mujoco>
